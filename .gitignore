# .gitignore - Radiator AI Inspection Project
# https://drive.google.com/drive/u/0/folders/1j-ANrECwDEjDqQ6HnznKJ0x7Vw0leTdP (Replace with your Google Drive link!)

# ================================================================================
# 📂 DATASET - IMPORTANT! Dataset stored on Google Drive, NOT in Git
# ================================================================================
# Large image files should be stored on Google Drive, not in Git
# Download link: https://drive.google.com/drive/u/0/folders/1j-ANrECwDEjDqQ6HnznKJ0x7Vw0leTdP
# Instructions: See GOOGLE_DRIVE_SETUP.md
dataset/images/train/*
dataset/images/val/*
dataset/images/test/*
dataset/labels/train/*
dataset/labels/val/*
dataset/labels/test/*

# Keep folder structure (gitkeep files)
!dataset/images/train/.gitkeep
!dataset/images/val/.gitkeep
!dataset/images/test/.gitkeep
!dataset/labels/train/.gitkeep
!dataset/labels/val/.gitkeep
!dataset/labels/test/.gitkeep

# Keep dataset config
!dataset/dataset.yaml

# ================================================================================
# 🤖 MODEL FILES - Large files, generate or download locally
# ================================================================================
models/radiator_detector/weights/best.pt
models/radiator_detector/weights/last.pt
models/radiator_detector/runs/
*.pt
*.onnx
*.tflite

# Keep model directory structure
!models/.gitkeep
!models/radiator_detector/.gitkeep
!models/radiator_detector/weights/.gitkeep

# ================================================================================
# 📊 RESULTS - Generated locally
# ================================================================================
results/inspections/*.json
results/logs/*.log
results/*
!results/.gitkeep
!results/inspections/.gitkeep
!results/logs/.gitkeep

